# Скопируйте в .env и заполните: cp .env.example .env
# .env исключён из git (см. .gitignore) — пароли не попадают в репозиторий.

# Пароль PostgreSQL (контейнер db и строка подключения приложения).
POSTGRES_PASSWORD=default_password

# Пароль демо-пользователей, создаваемых при первом старте (admin, operator, ...).
SEED_DEFAULT_PWD=otklik-demo-2026
